{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev:fe)",
      "Bash(pnpm dev:api)",
      "Bash(pnpm build:fe)",
      "Bash(pnpm build:api)",
      "Bash(pnpm --filter mgo_remak lint:*)",
      "Bash(pnpm --filter mgo_remak build)",
      "Bash(pnpm --filter mgo_remak dev)",
      "Bash(pnpm --filter api lint:*)",
      "Bash(pnpm --filter api test:*)",
      "Bash(pnpm --filter api build)",
      "Bash(pnpm --filter api format)",
      "Bash(pnpm --filter api db:generate)",
      "Bash(pnpm --filter api start:dev)",
      "Bash(pnpm exec prisma validate:*)",
      "Bash(pnpm exec prisma format:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(api/src/generated/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(pnpm --filter api exec prisma migrate reset:*)",
      "Bash(docker compose down -v:*)"
    ]
  }
}
