{
  "name": "@remak/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Logic thuần TypeScript dùng chung cho api và fe (locale, slug, link, bản dịch, phân trang)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./locale": {
      "types": "./dist/locale.d.ts",
      "default": "./dist/locale.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    },
    "./date": {
      "types": "./dist/date.d.ts",
      "default": "./dist/date.js"
    },
    "./slug": {
      "types": "./dist/slug.d.ts",
