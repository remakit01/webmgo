    },
    "./hero-i18n": {
      "types": "./dist/hero-i18n.d.ts",
      "default": "./dist/hero-i18n.js"
    },
    "./pagination": {
      "types": "./dist/pagination.d.ts",
      "default": "./dist/pagination.js"
    },
    "./rich-content": {
      "types": "./dist/rich-content.d.ts",
