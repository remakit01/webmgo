    "./rich-ai": {
      "types": "./dist/rich-ai.d.ts",
      "default": "./dist/rich-ai.js"
    },
    "./contracts/ai-writer": {
      "types": "./dist/contracts/ai-writer.d.ts",
      "default": "./dist/contracts/ai-writer.js"
