    "./contracts/ai-knowledge": {
      "types": "./dist/contracts/ai-knowledge.d.ts",
      "default": "./dist/contracts/ai-knowledge.js"
    },
    "./text-rank": {
      "types": "./dist/text-rank.d.ts",
      "default": "./dist/text-rank.js"
    },
    "./traffic-source": {
      "types": "./dist/traffic-source.d.ts",
      "default": "./dist/traffic-source.js"
    },
    "./contracts/news-stats": {
      "types": "./dist/contracts/news-stats.d.ts",
      "default": "./dist/contracts/news-stats.js"
    },
    "./contracts/product": {
      "types": "./dist/contracts/product.d.ts",
      "default": "./dist/contracts/product.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
