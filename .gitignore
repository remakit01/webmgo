# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# security & credentials
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.keystore
*.jks
credentials.json
client_secret*.json
service-account*.json
google-services*.json
GoogleService-Info.plist

# env files (keep .env.example only)
.env*
!.env.example

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# editor & ide
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini

# vercel & cloud
.vercel

# typescript & cache
*.tsbuildinfo
next-env.d.ts
.eslintcache
.cache/
.temp/
.tmp/
