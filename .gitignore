# ==============================================================================
# Global Git Ignore for Monorepo (Root, fe/, cms/, api/)
# ==============================================================================

# Dependencies (Root & all packages)
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Test & Coverage (NestJS Vitest / Jest / Playwright)
coverage/
*.lcov
.nyc_output/

# Next.js & Frontend Build Outputs (fe/ & cms/)
.next/
out/

# Production Builds & Compilations (NestJS api/dist, TypeScript dist, etc.)
build/
dist/

# Monorepo Caches
.turbo/
.cache/
.temp/
.tmp/
*.tsbuildinfo
next-env.d.ts
.eslintcache

# Security & Private Credentials
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.keystore
*.jks
credentials.json
client_secret*.json
service-account*.json
google-services*.json
GoogleService-Info.plist

# Environment Configuration (Keep all .env.example files across root & workspaces)
.env
.env.*
.env*.local
!**/.env.example

# Local Database & Storage Volumes (Docker mount data)
postgres_data/
redis_data/
minio_data/
*.sqlite
*.sqlite-journal
*.db

# Logs & Debugging
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor & IDE configs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini

# Cloud & Vercel
.vercel

# Prisma generated client
api/src/generated/
