// This is your Prisma schema file
// Docs: https://pris.ly/d/prisma-schema
//
// Quy ước DB (Postgres best practices):
// - Tên bảng/cột snake_case (@@map/@map) để viết SQL tay không phải quote; field trong code vẫn camelCase.
// - Mọi DateTime dùng timestamptz (@db.Timestamptz(3)) — không phụ thuộc múi giờ server.
// - Mọi cột khoá ngoại đều có index (Postgres không tự tạo).
// - Thay đổi schema qua `prisma migrate` (prisma/migrations), không dùng `db push`.
//   CHECK constraint không khai báo được trong Prisma — nằm trong file migration SQL.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  username  String?  @unique
  email     String   @unique
  password  String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  deletedBanners     Banner[]      @relation("BannerDeletedBy")
  createdNewsPosts   NewsPost[]    @relation("NewsPostCreatedBy")
  updatedNewsPosts   NewsPost[]    @relation("NewsPostUpdatedBy")
  deletedNewsPosts   NewsPost[]    @relation("NewsPostDeletedBy")
  createdAiKnowledge AiKnowledge[] @relation("AiKnowledgeCreatedBy")
  updatedAiKnowledge AiKnowledge[] @relation("AiKnowledgeUpdatedBy")

  @@map("users")
}

enum Role {
  ADMIN
  EDITOR

  @@map("role")
}

// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  specs ProductSpec[]

  @@map("products")
}

model ProductSpec {
  id           String  @id @default(cuid())
  productId    String  @map("product_id")
  thickness    Float
  fireRating   String? @map("fire_rating") // EI value (e.g. "EI 60")
  density      Float?
  bendStrength Float?  @map("bend_strength")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // FK + ON DELETE CASCADE: không có index thì xoá 1 sản phẩm phải quét toàn bảng thông số
  @@index([productId])
  @@map("product_specs")
}

// ─── Banners ─────────────────────────────────────────────────────────────────

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  alt       String
  ctaText   String?  @map("cta_text")
  imageUrl  String   @map("image_url") // biến thể mặc định (fallback cho <img>)
  imageKey  String   @map("image_key") // prefix object trong MinIO (vd: banners/<id>) để dọn khi xoá/thay ảnh
  images    Json // [{ width, format, url }] — CHECK là mảng JSON (xem migration)
  linkUrl   String?  @map("link_url")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order") // CHECK >= 0 (xem migration)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Soft delete: vào thùng rác, khôi phục được trong thời hạn lưu; job purge xoá hẳn (DB + MinIO) sau đó
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id")
  deletedBy   User?     @relation("BannerDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Partial index: danh sách CMS + trang chủ chỉ đọc banner chưa xoá, sắp theo sort_order
  @@index([sortOrder], map: "banners_live_sort_order_idx", where: raw("deleted_at IS NULL"))
  // Partial index: thùng rác (sắp theo deleted_at) và job dọn (deleted_at < cutoff)
  @@index([deletedAt], map: "banners_trash_deleted_at_idx", where: raw("deleted_at IS NOT NULL"))
  @@index([deletedById])
  @@map("banners")
}

// ─── Site settings (key-value) ───────────────────────────────────────────────

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}

// ─── Đa ngôn ngữ & xuất bản (dùng chung mọi loại nội dung) ──────────────────
// Mẫu dịch: mỗi thực thể có bảng <Entity>Translation (khoá (entity_id, locale)); slug unique theo (locale, slug).
// Thêm ngôn ngữ mới chỉ cần thêm giá trị enum, không đổi cấu trúc bảng.

enum ContentLocale {
  vi
  en

  @@map("content_locale")
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED

  @@map("publish_status")
}

enum TranslationOrigin {
  HUMAN
  AI // bản nháp AI chưa ai sửa
  AI_REVIEWED // bản AI đã được biên tập viên chỉnh/duyệt

  @@map("translation_origin")
}

/// Slug cũ của nội dung đã đăng -> 301 sang slug hiện tại. Dùng chung (entity_type: 'news_post', ...),
/// không có FK vì đa hình — xoá nội dung thì service tự xoá redirect.
model SlugRedirect {
  entityType String        @map("entity_type")
  locale     ContentLocale
  oldSlug    String        @map("old_slug")
  entityId   String        @map("entity_id")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([entityType, locale, oldSlug])
  @@index([entityType, entityId])
  @@map("slug_redirects")
}

// ─── Tin tức ─────────────────────────────────────────────────────────────────

model NewsCategory {
  id        String   @id @default(cuid())
  color     String   @default("green") // token thương hiệu (NEWS_CATEGORY_COLORS) — CHECK trong migration
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations NewsCategoryTranslation[]
  posts        NewsPost[]

  @@map("news_categories")
}

model NewsCategoryTranslation {
  categoryId     String        @map("category_id")
  locale         ContentLocale
  name           String
  slug           String
  description    String?
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")

  category NewsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // PK bắt đầu bằng category_id nên đã phủ index cho FK
  @@id([categoryId, locale])
  @@unique([locale, slug])
  @@map("news_category_translations")
}

model NewsTag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations NewsTagTranslation[]
  posts        NewsPostTag[]

  @@map("news_tags")
}

model NewsTagTranslation {
  tagId  String        @map("tag_id")
  locale ContentLocale
  name   String
  slug   String

  tag NewsTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, locale])
  @@unique([locale, slug])
  @@map("news_tag_translations")
}

model NewsAuthor {
  id        String   @id @default(cuid())
  name      String // tên riêng, không dịch
  avatarUrl String?  @map("avatar_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations NewsAuthorTranslation[]
  posts        NewsPost[]

  @@map("news_authors")
}

model NewsAuthorTranslation {
  authorId String        @map("author_id")
  locale   ContentLocale
  jobTitle String?       @map("job_title")
  bio      String?

  author NewsAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([authorId, locale])
  @@map("news_author_translations")
}

/// Thông tin chung của bài (không phụ thuộc ngôn ngữ). Nội dung từng ngôn ngữ ở NewsPostTranslation.
model NewsPost {
  id            String    @id @default(cuid())
  categoryId    String    @map("category_id")
  authorId      String?   @map("author_id")
  coverImageKey String?   @map("cover_image_key") // prefix MinIO để dọn khi thay/xoá ảnh
  coverImageUrl String?   @map("cover_image_url")
  coverImages   Json?     @map("cover_images") // [{ width, format, url }] — CHECK là mảng JSON
  isFeatured    Boolean   @default(false) @map("is_featured")
  /// Tổng lượt xem mọi ngôn ngữ — tăng cùng lệnh ghi news_post_daily_stats (sắp / lọc danh sách không phải cộng bảng ngày)
  viewCount     Int       @default(0) @map("view_count")
  featuredOrder Int?      @map("featured_order")
  createdById   String?   @map("created_by_id")
  updatedById   String?   @map("updated_by_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById   String?   @map("deleted_by_id")

  // Chuyên mục còn bài thì không xoá được (Restrict) — CMS báo chuyển bài sang chuyên mục khác trước
  category     NewsCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author       NewsAuthor?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdBy    User?                 @relation("NewsPostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?                 @relation("NewsPostUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy    User?                 @relation("NewsPostDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  translations NewsPostTranslation[]
  tags         NewsPostTag[]
  dailyStats   NewsPostDailyStat[]

  @@index([categoryId])
  @@index([authorId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  // Danh sách CMS: bài chưa xoá, mới sửa trước
  @@index([updatedAt(sort: Desc)], map: "news_posts_live_updated_at_idx", where: raw("deleted_at IS NULL"))
  @@map("news_posts")
}

model NewsPostTranslation {
  postId           String            @map("post_id")
  locale           ContentLocale
  status           PublishStatus     @default(DRAFT)
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(3)
  firstPublishedAt DateTime?         @map("first_published_at") @db.Timestamptz(3)
  title            String
  slug             String
  sapo             String
  content          Json // RichDoc (@remak/shared/rich-content) — kiểm tra ở API trước khi lưu
  contentText      String            @default("") @map("content_text") // plain text: tìm kiếm, thời gian đọc
  readingMinutes   Int               @default(1) @map("reading_minutes")
  coverAlt         String            @default("") @map("cover_alt")
  coverCaption     String?           @map("cover_caption")
  focusKeyword     String?           @map("focus_keyword") // keyword chính theo ngôn ngữ — chấm điểm SEO/AEO/GEO
  seoTitle         String?           @map("seo_title")
  seoDescription   String?           @map("seo_description")
  ogImageUrl       String?           @map("og_image_url")
  noindex          Boolean           @default(false)
  sourceName       String?           @map("source_name") // "Theo ..."
  sourceUrl        String?           @map("source_url")
  origin           TranslationOrigin @default(HUMAN)
  // Lần cuối nội dung (chữ) thay đổi — khác updatedAt (đổi trạng thái xuất bản cũng tăng updatedAt)
  contentUpdatedAt DateTime          @default(now()) @map("content_updated_at") @db.Timestamptz(3)
  sourceUpdatedAt  DateTime?         @map("source_updated_at") @db.Timestamptz(3) // contentUpdatedAt bản vi lúc dịch
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  post NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, locale])
  @@unique([locale, slug])
  // Trang danh sách public: WHERE locale = ? AND status = 'PUBLISHED' AND published_at <= now() ORDER BY published_at DESC
  @@index([locale, publishedAt(sort: Desc)], map: "news_post_translations_public_idx", where: raw("status = 'PUBLISHED'"))
  // Cron đăng bài hẹn giờ: WHERE status = 'SCHEDULED' AND published_at <= now()
  @@index([publishedAt], map: "news_post_translations_scheduled_idx", where: raw("status = 'SCHEDULED'"))
  @@map("news_post_translations")
}

model NewsPostTag {
  postId String @map("post_id")
  tagId  String @map("tag_id")

  post NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  NewsTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("news_post_tags")
}

// ─── Kho "Kiến thức AI" ─────────────────────────────────────────────────────
// Kiến thức công ty cho trợ lý AI viết bài (thông số sản phẩm, chứng nhận, quy trình...).
// AI tra cứu bằng tìm kiếm lai: từ khoá (BM25) + embedding ngữ nghĩa (ai_embeddings).

enum AiKnowledgeKind {
  PRODUCT
  SPEC
  CERTIFICATION
  APPLICATION
  PROJECT
  FAQ
  PROCESS
  COMPANY
  MARKET
  OTHER

  @@map("ai_knowledge_kind")
}

enum AiKnowledgeStatus {
  ACTIVE
  ARCHIVED

  @@map("ai_knowledge_status")
}

enum AiKnowledgeOrigin {
  SEED // nạp sẵn từ dữ liệu site
  HUMAN // biên tập viên nhập
  AI_WEB // AI tìm trên web, biên tập viên đã duyệt

  @@map("ai_knowledge_origin")
}

model AiKnowledge {
  id          String            @id @default(cuid())
  kind        AiKnowledgeKind
  title       String
  content     String // CHECK độ dài trong migration
  tags        String[]          @default([])
  sourceUrl   String?           @map("source_url")
  sourceTitle String?           @map("source_title")
  status      AiKnowledgeStatus @default(ACTIVE)
  origin      AiKnowledgeOrigin @default(HUMAN)
  pinned      Boolean           @default(false) // luôn đưa vào ngữ cảnh AI (vd hồ sơ công ty)
  verifiedAt  DateTime?         @map("verified_at") @db.Timestamptz(3)
  createdById String?           @map("created_by_id")
  updatedById String?           @map("updated_by_id")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User? @relation("AiKnowledgeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("AiKnowledgeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, kind])
  @@index([createdById])
  @@index([updatedById])
  @@map("ai_knowledge")
}

/// Vector embedding theo đoạn của kiến thức / bài Tin tức (cosine tính trong Node — kho nhỏ, không cần pgvector)
model AiEmbedding {
  sourceType String   @map("source_type") // 'knowledge' | 'news'
  sourceId   String   @map("source_id")
  chunk      Int
  model      String
  textHash   String   @map("text_hash")
  text       String
  vector     Float[]  @db.Real
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // model đứng đầu: mọi truy vấn đều lọc theo model trước (WHERE model = ... [AND source_type / source_id])
  @@id([model, sourceType, sourceId, chunk])
  @@map("ai_embeddings")
}

// ─── Lượt xem bài Tin tức ───────────────────────────────────────────────────
// Gộp theo ngày (giờ Việt Nam) / ngôn ngữ / nguồn truy cập — không lưu từng lượt, không lưu IP.

enum TrafficSource {
  DIRECT // không có referrer
  INTERNAL // từ trang khác của chính site
  SEARCH // Google, Bing, Cốc Cốc...
  AI // ChatGPT, Perplexity, Gemini, Copilot, Claude...
  SOCIAL // Facebook, Zalo, LinkedIn, YouTube...
  OTHER

  @@map("traffic_source")
}

model NewsPostDailyStat {
  postId      String        @map("post_id")
  locale      ContentLocale
  day         DateTime      @db.Date
  source      TrafficSource
  views       Int           @default(0)
  /// Lượt đọc tới 75% bài
  reads       Int           @default(0)
  /// Tổng số giây đọc thật (tab đang mở)
  readSeconds BigInt        @default(0) @map("read_seconds")

  post NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // PK bắt đầu bằng post_id: thống kê một bài + upsert tăng số; index day: "xem nhiều N ngày", Dashboard
  @@id([postId, locale, day, source])
  @@index([day])
  @@map("news_post_daily_stats")
}
