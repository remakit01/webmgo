// This is your Prisma schema file
// Docs: https://pris.ly/d/prisma-schema
//
// Quy ước DB (Postgres best practices):
// - Tên bảng/cột snake_case (@@map/@map) để viết SQL tay không phải quote; field trong code vẫn camelCase.
// - Mọi DateTime dùng timestamptz (@db.Timestamptz(3)) — không phụ thuộc múi giờ server.
// - Mọi cột khoá ngoại đều có index (Postgres không tự tạo).
// - Thay đổi schema qua `prisma migrate` (prisma/migrations), không dùng `db push`.
//   CHECK constraint không khai báo được trong Prisma — nằm trong file migration SQL.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  username  String?  @unique
  email     String   @unique
  password  String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  deletedBanners     Banner[]      @relation("BannerDeletedBy")
  createdNewsPosts   NewsPost[]    @relation("NewsPostCreatedBy")
  updatedNewsPosts   NewsPost[]    @relation("NewsPostUpdatedBy")
  deletedNewsPosts   NewsPost[]    @relation("NewsPostDeletedBy")
  createdAiKnowledge AiKnowledge[] @relation("AiKnowledgeCreatedBy")
  updatedAiKnowledge AiKnowledge[] @relation("AiKnowledgeUpdatedBy")

  @@map("users")
}

enum Role {
  ADMIN
  EDITOR

  @@map("role")
}

// ─── Sản phẩm tấm MgO (docs/catalog-mgo/MODEL_*.md) ─────────────────────────
// Product (1 dòng tấm = 1 trang web) + ProductTranslation (vi/en, SEO) + ProductTechnicalSpec (1-1: TDS chung, 5 nhóm
// physical / mechanical / thermalFire / acousticMoisture / chemistrySafety) + ProductVariant (1-N: mỗi độ dày = NGUỒN DUY NHẤT
// cho kg/tấm, EI, giá, tình trạng hàng) + phần mở rộng 1-1 theo loại (SIP / Sàn / Trang trí) + Chứng chỉ.
// Số đo lưu dạng khoảng min / max (vd "≥ 25 MPa" -> min 25), không lưu chữ; thiếu dữ liệu = NULL, KHÔNG có giá trị mặc định bịa.
// Tập giá trị hay mở rộng (bề mặt, màu, loại sàn phủ…) lưu text, kiểm bằng hằng số @remak/shared/contracts/product.

/// Mẫu form thông số riêng của Loại sản phẩm — quyết định phần mở rộng nào được dùng (cố định vì mỗi mẫu có bảng riêng)
enum ProductSpecProfile {
  NONE
  SIP
  FLOOR
  DECORATIVE

  @@map("product_spec_profile")
}

/// Loại sản phẩm — quản lý trong CMS (thêm / sửa / xoá / sắp thứ tự), mỗi loại có trang riêng trên web
model ProductType {
  id          String             @id @default(cuid())
  specProfile ProductSpecProfile @default(NONE) @map("spec_profile")
  sortOrder   Int                @default(0) @map("sort_order")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations ProductTypeTranslation[]
  products     Product[]

  @@map("product_types")
}

model ProductTypeTranslation {
  typeId         String        @map("type_id")
  locale         ContentLocale
  name           String
  slug           String
  description    String?
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")

  type ProductType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  // PK bắt đầu bằng type_id nên đã phủ index cho FK
  @@id([typeId, locale])
  @@unique([locale, slug])
  @@map("product_type_translations")
}

/// Cách hiển thị giá: có giá cụ thể / liên hệ báo giá (không xuất giá ra Google)
enum PriceMode {
  FIXED
  CONTACT

  @@map("price_mode")
}

/// Tình trạng hàng — khớp schema.org ItemAvailability
enum StockStatus {
  IN_STOCK
  LIMITED
  PRE_ORDER
  BACK_ORDER
  OUT_OF_STOCK
  DISCONTINUED

  @@map("stock_status")
}

enum SaleUnit {
  SHEET
  M2

  @@map("sale_unit")
}

/// Nhóm danh mục thông số — mỗi nhóm gắn với cột thông số cụ thể (xem SPEC_OPTION_GROUP_LABEL ở @remak/shared)
enum SpecOptionGroup {
  EDGE_PROFILE
  CORE_COLOR
  SURFACE_FINISH
  SCREW_HOLDING
  CRYSTAL_PHASE
  VOC_LEVEL
  SUITABLE_FLOORING
  SIP_CORE_MATERIAL
  LOAD_BEARING
  DECORATIVE_FINISH
  SCRATCH_RESISTANCE

  @@map("spec_option_group")
}

/// Giá trị danh mục thông số (kiểu cạnh, màu lõi, pha tinh thể…) — quản lý trong CMS; cột sản phẩm lưu `code`
model SpecOption {
  id        String          @id @default(cuid())
  group     SpecOptionGroup
  /// Mã lưu trong cột sản phẩm — KHÔNG đổi sau khi tạo (CHECK định dạng trong migration)
  code      String
  sortOrder Int             @default(0) @map("sort_order")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations SpecOptionTranslation[]

  @@unique([group, code])
  // Danh sách theo nhóm, đúng thứ tự CMS
  @@index([group, sortOrder, id])
  @@map("spec_options")
}

model SpecOptionTranslation {
  optionId String        @map("option_id")
  locale   ContentLocale
  label    String

  option SpecOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  // PK bắt đầu bằng option_id nên đã phủ index cho FK
  @@id([optionId, locale])
  @@map("spec_option_translations")
}

/// Dòng tấm MgO (= 1 trang sản phẩm)
model Product {
  id            String      @id @default(cuid())
  /// Loại không xoá được khi còn sản phẩm (kể cả trong thùng rác)
  typeId        String      @map("product_type_id")
  coverImageKey String?     @map("cover_image_key")
  coverImageUrl String?     @map("cover_image_url")
  /// [{ url, key?, width?, height? }] — chú thích ảnh theo ngôn ngữ ở ProductTranslation.galleryAlts
  gallery       Json        @default("[]")
  isFeatured    Boolean     @default(false) @map("is_featured")
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(3)

  type              ProductType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  translations      ProductTranslation[]
  technicalSpec     ProductTechnicalSpec?
  variants          ProductVariant[]
  sipSpec           SipPanelSpec?
  floorSpec         FloorBoardSpec?
  decorativeSpec    DecorativeFinishSpec?
  decorativeOptions DecorativeFinishOption[]
  certificates      ProductCertificate[]

  // Danh sách web: chưa xoá, theo thứ tự
  @@index([sortOrder, id], map: "products_live_idx", where: raw("deleted_at IS NULL"))
  @@index([typeId])
  @@map("products")
}

model ProductTranslation {
  productId        String            @map("product_id")
  locale           ContentLocale
  status           PublishStatus     @default(DRAFT)
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(3)
  name             String
  slug             String
  tagline          String?
  summary          String            @default("")
  /// RichDoc (@remak/shared/rich-content)
  description      Json              @default("{\"type\":\"doc\",\"content\":[]}")
  highlights       String[]          @default([])
  /// [{ title, desc }] — gồm cả tuyên bố marketing (LiteCore "nhanh gấp 5 lần"…)
  advantages       Json              @default("[]")
  /// [{ q, a }]
  faqs             Json              @default("[]")
  coverAlt         String            @default("") @map("cover_alt")
  galleryAlts      String[]          @default([]) @map("gallery_alts")
  focusKeyword     String?           @map("focus_keyword")
  seoTitle         String?           @map("seo_title")
  seoDescription   String?           @map("seo_description")
  ogImageUrl       String?           @map("og_image_url")
  noindex          Boolean           @default(false)
  origin           TranslationOrigin @default(HUMAN)
  contentUpdatedAt DateTime          @default(now()) @map("content_updated_at") @db.Timestamptz(3)
  sourceUpdatedAt  DateTime?         @map("source_updated_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
  @@unique([locale, slug])
  @@map("product_translations")
}

/// TDS chung của dòng tấm (1-1). Code gom thành 5 sub-model: xem toSpecView() ở @remak/shared/contracts/product
model ProductTechnicalSpec {
  productId String @id @map("product_id")

  // ── physical ──
  /// Khổ tiêu chuẩn: [{ widthMm, lengthMm }]
  standardSizes Json         @default("[]") @map("standard_sizes")
  edgeProfile   String?      @map("edge_profile")
  /// Khoá màu cốt tấm (OFF_WHITE, LIGHT_GREY…)
  coreColor     String?      @map("core_color")
  /// Khoá hoàn thiện bề mặt (SMOOTH, SANDED, HPL…)
  surfaceFinish String?      @map("surface_finish")

  // ── mechanical ──
  densityMinKgM3      Int?     @map("density_min_kg_m3")
  densityMaxKgM3      Int?     @map("density_max_kg_m3")
  /// LiteCore: nhẹ hơn ~70% so với tấm thường
  densityReductionPct Decimal? @map("density_reduction_pct") @db.Decimal(5, 2)
  flexuralMinMpa      Decimal? @map("flexural_min_mpa") @db.Decimal(6, 2)
  flexuralMaxMpa      Decimal? @map("flexural_max_mpa") @db.Decimal(6, 2)
  /// Cường độ uốn chiều ngang (tối thiểu)
  flexuralCrossMinMpa Decimal? @map("flexural_cross_min_mpa") @db.Decimal(6, 2)
  /// Khoá mức bám vít (EXCELLENT, GOOD, STANDARD)
  screwHoldingRating  String?  @map("screw_holding_rating")

  // ── thermalFire ── (dải EI không lưu ở đây: suy ra từ các độ dày)
  /// Cấp phản ứng với lửa, vd "A1"
  reactionToFireClass    String?  @map("reaction_to_fire_class")
  /// Tiêu chuẩn cấp cháy vật liệu: ASTM E84, EN 13501-1, UL 055…
  fireClassStandards     String[] @default([]) @map("fire_class_standards")
  maxTemperatureC        Int?     @map("max_temperature_c")
  thermalConductivityWmk Decimal? @map("thermal_conductivity_wmk") @db.Decimal(6, 4)

  // ── acousticMoisture ──
  soundReductionMinDb     Int?     @map("sound_reduction_min_db")
  soundReductionMaxDb     Int?     @map("sound_reduction_max_db")
  waterAbsorptionMaxPct   Decimal? @map("water_absorption_max_pct") @db.Decimal(5, 2)
  thicknessSwellingMaxPct Decimal? @map("thickness_swelling_max_pct") @db.Decimal(5, 3)
  moldResistant           Boolean? @map("mold_resistant")

  // ── chemistrySafety ──
  /// Khoá pha tinh thể (PHASE_517…)
  crystalPhase        String?  @map("crystal_phase")
  mgoContentMinPct    Decimal? @map("mgo_content_min_pct") @db.Decimal(5, 2)
  chlorideMaxPct      Decimal? @map("chloride_max_pct") @db.Decimal(5, 3)
  asbestosFree        Boolean? @map("asbestos_free")
  formaldehydeMgL     Decimal? @map("formaldehyde_mg_l") @db.Decimal(6, 3)
  /// Khoá mức VOC (VERY_LOW, LOW…)
  vocLevel            String?  @map("voc_level")
  /// LEED, GREEN STAR…
  greenCertifications String[] @default([]) @map("green_certifications")

  /// Chỉ tiêu mới chưa có cột: [{ key, value, unit? }]
  extraSpecs Json     @default("[]") @map("extra_specs")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_technical_specs")
}

/// Quy cách theo độ dày (1-N) — nguồn duy nhất cho kg/tấm, EI, cường độ uốn theo độ dày, giá, tình trạng hàng
model ProductVariant {
  id                   String      @id @default(cuid())
  productId            String      @map("product_id")
  sku                  String?     @unique
  thicknessMm          Decimal     @map("thickness_mm") @db.Decimal(5, 2)
  /// Khổ tấm — bắt buộc (cùng độ dày có thể có nhiều khổ, vd sàn 2440×1220 và 2700×600; unique cần giá trị khác NULL)
  widthMm              Int         @map("width_mm")
  lengthMm             Int         @map("length_mm")
  weightKg             Decimal?    @map("weight_kg") @db.Decimal(8, 2)
  /// Ghi đè tỷ trọng của dòng khi độ dày này khác
  densityKgM3          Int?        @map("density_kg_m3")
  fireRatingMinMinutes Int?        @map("fire_rating_min_minutes")
  fireRatingMaxMinutes Int?        @map("fire_rating_max_minutes")
  /// Nhãn hiển thị đầy đủ, vd "EI 45 – EI 60", "Euroclass A1, EI 30"
  fireRatingLabel      String?     @map("fire_rating_label")
  flexuralMinMpa       Decimal?    @map("flexural_min_mpa") @db.Decimal(6, 2)
  isPopular            Boolean     @default(false) @map("is_popular")
  isDefault            Boolean     @default(false) @map("is_default")
  isActive             Boolean     @default(true) @map("is_active")
  sortOrder            Int         @default(0) @map("sort_order")
  priceMode            PriceMode   @default(CONTACT) @map("price_mode")
  /// VND / đơn vị bán, chưa VAT (số nguyên — VND không có phần lẻ)
  priceVnd             Int?        @map("price_vnd")
  compareAtPriceVnd    Int?        @map("compare_at_price_vnd")
  saleUnit             SaleUnit    @default(SHEET) @map("sale_unit")
  priceValidUntil      DateTime?   @map("price_valid_until") @db.Date
  stockStatus          StockStatus @default(IN_STOCK) @map("stock_status")
  leadTimeDays         Int?        @map("lead_time_days")
  minOrderQty          Int?        @map("min_order_qty")
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  product      Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations ProductVariantTranslation[]
  certificates ProductVariantCertificate[]

  @@unique([productId, thicknessMm, widthMm, lengthMm])
  /// Mỗi dòng tối đa 1 độ dày mặc định
  @@unique([productId], map: "product_variants_one_default_idx", where: raw("is_default"))
  @@index([productId, sortOrder, id])
  /// Lọc "đạt EI ≥ X" trên các độ dày đang bán
  @@index([fireRatingMaxMinutes], map: "product_variants_fire_idx", where: raw("is_active"))
  @@map("product_variants")
}

model ProductVariantTranslation {
  variantId      String        @map("variant_id")
  locale         ContentLocale
  /// Tên quy cách, vd "Tấm 8mm" (bỏ trống = tự sinh từ độ dày)
  label          String?
  /// Ứng dụng khuyến nghị, vd "Ống gió hút khói PCCC, vách phòng sạch"
  recommendedUse String?       @map("recommended_use")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([variantId, locale])
  @@map("product_variant_translations")
}

/// Mở rộng cho panel SIP MgO (loại có mẫu thông số SIP)
model SipPanelSpec {
  productId           String            @id @map("product_id")
  coreMaterials       String[]          @default([]) @map("core_materials")
  coreThicknessMinMm  Int?              @map("core_thickness_min_mm")
  coreThicknessMaxMm  Int?              @map("core_thickness_max_mm")
  /// Độ dày tấm MgO ốp 2 mặt, vd [10, 12]
  facingThicknessesMm Int[]             @default([]) @map("facing_thicknesses_mm")
  maxWidthMm          Int?              @map("max_width_mm")
  maxLengthMm         Int?              @map("max_length_mm")
  /// Khoá khả năng chịu lực (STRUCTURAL, NON_STRUCTURAL…)
  loadBearing         String?           @map("load_bearing")
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("sip_panel_specs")
}

/// Mở rộng cho tấm sàn MgO (loại có mẫu thông số FLOOR)
model FloorBoardSpec {
  productId              String        @id @map("product_id")
  edgeProfiles           String[]      @default([]) @map("edge_profiles")
  /// Khổ sàn: [{ widthMm, lengthMm }]
  floorSizes             Json          @default("[]") @map("floor_sizes")
  /// Khoá vật liệu lót sàn tương thích (WOOD, TILE, CARPET, EPOXY, VINYL…)
  suitableFloorings      String[]      @default([]) @map("suitable_floorings")
  moistureResistantFloor Boolean?      @map("moisture_resistant_floor")
  sandedSurface          Boolean?      @map("sanded_surface")
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("floor_board_specs")
}

/// Mở rộng cho tấm trang trí FireSafe (loại có mẫu thông số DECORATIVE)
model DecorativeFinishSpec {
  productId            String   @id @map("product_id")
  customPrintSupported Boolean  @default(false) @map("custom_print_supported")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("decorative_finish_specs")
}

/// Các lớp hoàn thiện có sẵn của tấm trang trí (HPL / PVC / sơn trương nở / in 3D)
model DecorativeFinishOption {
  id                String               @id @default(cuid())
  productId         String               @map("product_id")
  finishType        String               @map("finish_type")
  /// Khoá mức chống trầy (VERY_HIGH, HIGH, STANDARD)
  scratchResistance String?              @map("scratch_resistance")
  sortOrder         Int                  @default(0) @map("sort_order")

  product      Product                             @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations DecorativeFinishOptionTranslation[]

  @@unique([productId, finishType])
  @@index([productId, sortOrder, id])
  @@map("decorative_finish_options")
}

model DecorativeFinishOptionTranslation {
  optionId      String        @map("option_id")
  locale        ContentLocale
  name          String
  description   String?
  /// Hoa văn có sẵn, vd ["Vân gỗ sồi", "Vân đá marble"]
  patterns      String[]      @default([])
  /// Không gian phù hợp, vd ["Sảnh lễ tân", "Phòng sạch"]
  suitableAreas String[]      @default([]) @map("suitable_areas")

  option DecorativeFinishOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([optionId, locale])
  @@map("decorative_finish_option_translations")
}

/// Hồ sơ kiểm định / chứng chỉ (vd "Kiểm định vách EI90 theo QCVN 06:2022", "UL 055")
model Certificate {
  id            String    @id @default(cuid())
  certificateNo String?   @map("certificate_no")
  /// Đơn vị cấp: IBST, UL, Cục PCCC…
  issuingBody   String?   @map("issuing_body")
  /// Tiêu chuẩn thử: QCVN 06:2022/BXD, ASTM E84…
  testStandard  String?   @map("test_standard")
  /// Kết quả: "EI 90", "Class A"…
  result        String?
  issueDate     DateTime? @map("issue_date") @db.Date
  /// null = không hết hạn. Trạng thái còn hạn / sắp hết / hết hạn tính từ ngày này (không lưu tay)
  expiryDate    DateTime? @map("expiry_date") @db.Date
  fileKey       String?   @map("file_key")
  fileUrl       String?   @map("file_url")
  isPublic      Boolean   @default(true) @map("is_public")
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations CertificateTranslation[]
  products     ProductCertificate[]
  variants     ProductVariantCertificate[]

  /// Cảnh báo chứng chỉ sắp hết hạn
  @@index([expiryDate], map: "certificates_expiry_idx", where: raw("is_public AND expiry_date IS NOT NULL"))
  @@map("certificates")
}

model CertificateTranslation {
  certificateId String        @map("certificate_id")
  locale        ContentLocale
  name          String
  description   String?

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@id([certificateId, locale])
  @@map("certificate_translations")
}

/// Chứng chỉ áp cho cả dòng tấm
model ProductCertificate {
  productId     String @map("product_id")
  certificateId String @map("certificate_id")
  sortOrder     Int    @default(0) @map("sort_order")

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@id([productId, certificateId])
  @@index([certificateId])
  @@map("product_certificates")
}

/// Chứng chỉ chỉ áp cho một độ dày (vd tấm 12mm đạt EI 120)
model ProductVariantCertificate {
  variantId     String @map("variant_id")
  certificateId String @map("certificate_id")

  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  certificate Certificate    @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@id([variantId, certificateId])
  @@index([certificateId])
  @@map("product_variant_certificates")
}

// ─── Banners ─────────────────────────────────────────────────────────────────

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  alt       String
  ctaText   String?  @map("cta_text")
  imageUrl  String   @map("image_url") // biến thể mặc định (fallback cho <img>)
  imageKey  String   @map("image_key") // prefix object trong MinIO (vd: banners/<id>) để dọn khi xoá/thay ảnh
  images    Json // [{ width, format, url }] — CHECK là mảng JSON (xem migration)
  linkUrl   String?  @map("link_url")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order") // CHECK >= 0 (xem migration)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Soft delete: vào thùng rác, khôi phục được trong thời hạn lưu; job purge xoá hẳn (DB + MinIO) sau đó
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id")
  deletedBy   User?     @relation("BannerDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Partial index: danh sách CMS + trang chủ chỉ đọc banner chưa xoá, sắp theo sort_order
  @@index([sortOrder], map: "banners_live_sort_order_idx", where: raw("deleted_at IS NULL"))
  // Partial index: thùng rác (sắp theo deleted_at) và job dọn (deleted_at < cutoff)
  @@index([deletedAt], map: "banners_trash_deleted_at_idx", where: raw("deleted_at IS NOT NULL"))
  @@index([deletedById])
  @@map("banners")
}

// ─── Site settings (key-value) ───────────────────────────────────────────────

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}

// ─── Đa ngôn ngữ & xuất bản (dùng chung mọi loại nội dung) ──────────────────
// Mẫu dịch: mỗi thực thể có bảng <Entity>Translation (khoá (entity_id, locale)); slug unique theo (locale, slug).
// Thêm ngôn ngữ mới chỉ cần thêm giá trị enum, không đổi cấu trúc bảng.

enum ContentLocale {
  vi
  en

  @@map("content_locale")
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED

  @@map("publish_status")
}

enum TranslationOrigin {
  HUMAN
  AI // bản nháp AI chưa ai sửa
  AI_REVIEWED // bản AI đã được biên tập viên chỉnh/duyệt

  @@map("translation_origin")
}

/// Slug cũ của nội dung đã đăng -> 301 sang slug hiện tại. Dùng chung (entity_type: 'news_post', ...),
/// không có FK vì đa hình — xoá nội dung thì service tự xoá redirect.
model SlugRedirect {
  entityType String        @map("entity_type")
  locale     ContentLocale
  oldSlug    String        @map("old_slug")
  entityId   String        @map("entity_id")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([entityType, locale, oldSlug])
  @@index([entityType, entityId])
  @@map("slug_redirects")
}

// ─── Tin tức ─────────────────────────────────────────────────────────────────

model NewsCategory {
  id        String   @id @default(cuid())
  color     String   @default("green") // token thương hiệu (NEWS_CATEGORY_COLORS) — CHECK trong migration
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations NewsCategoryTranslation[]
  posts        NewsPost[]

  @@map("news_categories")
}

model NewsCategoryTranslation {
  categoryId     String        @map("category_id")
  locale         ContentLocale
  name           String
  slug           String
  description    String?
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")

  category NewsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // PK bắt đầu bằng category_id nên đã phủ index cho FK
  @@id([categoryId, locale])
  @@unique([locale, slug])
  @@map("news_category_translations")
}

model NewsTag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations NewsTagTranslation[]
  posts        NewsPostTag[]

  @@map("news_tags")
}

model NewsTagTranslation {
  tagId  String        @map("tag_id")
  locale ContentLocale
  name   String
  slug   String

  tag NewsTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, locale])
  @@unique([locale, slug])
  @@map("news_tag_translations")
}

model NewsAuthor {
  id        String   @id @default(cuid())
  name      String // tên riêng, không dịch
  avatarUrl String?  @map("avatar_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations NewsAuthorTranslation[]
  posts        NewsPost[]

  @@map("news_authors")
}

model NewsAuthorTranslation {
  authorId String        @map("author_id")
  locale   ContentLocale
  jobTitle String?       @map("job_title")
  bio      String?

  author NewsAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([authorId, locale])
  @@map("news_author_translations")
}

/// Thông tin chung của bài (không phụ thuộc ngôn ngữ). Nội dung từng ngôn ngữ ở NewsPostTranslation.
model NewsPost {
  id            String    @id @default(cuid())
  categoryId    String    @map("category_id")
  authorId      String?   @map("author_id")
  coverImageKey String?   @map("cover_image_key") // prefix MinIO để dọn khi thay/xoá ảnh
  coverImageUrl String?   @map("cover_image_url")
  coverImages   Json?     @map("cover_images") // [{ width, format, url }] — CHECK là mảng JSON
  isFeatured    Boolean   @default(false) @map("is_featured")
  /// Tổng lượt xem mọi ngôn ngữ — tăng cùng lệnh ghi news_post_daily_stats (sắp / lọc danh sách không phải cộng bảng ngày)
  viewCount     Int       @default(0) @map("view_count")
  featuredOrder Int?      @map("featured_order")
  createdById   String?   @map("created_by_id")
  updatedById   String?   @map("updated_by_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById   String?   @map("deleted_by_id")

  // Chuyên mục còn bài thì không xoá được (Restrict) — CMS báo chuyển bài sang chuyên mục khác trước
  category     NewsCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author       NewsAuthor?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdBy    User?                 @relation("NewsPostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?                 @relation("NewsPostUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy    User?                 @relation("NewsPostDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  translations NewsPostTranslation[]
  tags         NewsPostTag[]
  dailyStats   NewsPostDailyStat[]

  @@index([categoryId])
  @@index([authorId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  // Danh sách CMS: bài chưa xoá, mới sửa trước; id = cột unique cuối ORDER BY (phân trang ổn định), khớp index không phải sắp lại
  @@index([updatedAt(sort: Desc), id(sort: Desc)], map: "news_posts_live_updated_at_idx", where: raw("deleted_at IS NULL"))
  @@map("news_posts")
}

model NewsPostTranslation {
  postId           String            @map("post_id")
  locale           ContentLocale
  status           PublishStatus     @default(DRAFT)
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(3)
  firstPublishedAt DateTime?         @map("first_published_at") @db.Timestamptz(3)
  title            String
  slug             String
  sapo             String
  content          Json // RichDoc (@remak/shared/rich-content) — kiểm tra ở API trước khi lưu
  contentText      String            @default("") @map("content_text") // plain text: tìm kiếm, thời gian đọc
  readingMinutes   Int               @default(1) @map("reading_minutes")
  coverAlt         String            @default("") @map("cover_alt")
  coverCaption     String?           @map("cover_caption")
  focusKeyword     String?           @map("focus_keyword") // keyword chính theo ngôn ngữ — chấm điểm SEO/AEO/GEO
  seoTitle         String?           @map("seo_title")
  seoDescription   String?           @map("seo_description")
  ogImageUrl       String?           @map("og_image_url")
  noindex          Boolean           @default(false)
  sourceName       String?           @map("source_name") // "Theo ..."
  sourceUrl        String?           @map("source_url")
  origin           TranslationOrigin @default(HUMAN)
  // Lần cuối nội dung (chữ) thay đổi — khác updatedAt (đổi trạng thái xuất bản cũng tăng updatedAt)
  contentUpdatedAt DateTime          @default(now()) @map("content_updated_at") @db.Timestamptz(3)
  sourceUpdatedAt  DateTime?         @map("source_updated_at") @db.Timestamptz(3) // contentUpdatedAt bản vi lúc dịch
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  post NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, locale])
  @@unique([locale, slug])
  // Trang danh sách public: WHERE locale = ? AND status = 'PUBLISHED' AND published_at <= now() ORDER BY published_at DESC
  // ... ORDER BY published_at DESC, post_id DESC (post_id: cột unique cuối, phân trang ổn định)
  @@index([locale, publishedAt(sort: Desc), postId(sort: Desc)], map: "news_post_translations_public_idx", where: raw("status = 'PUBLISHED'"))
  // Cron đăng bài hẹn giờ: WHERE status = 'SCHEDULED' AND published_at <= now()
  @@index([publishedAt], map: "news_post_translations_scheduled_idx", where: raw("status = 'SCHEDULED'"))
  @@map("news_post_translations")
}

model NewsPostTag {
  postId String @map("post_id")
  tagId  String @map("tag_id")

  post NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  NewsTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("news_post_tags")
}

// ─── Kho "Kiến thức AI" ─────────────────────────────────────────────────────
// Kiến thức công ty cho trợ lý AI viết bài (thông số sản phẩm, chứng nhận, quy trình...).
// AI tra cứu bằng tìm kiếm lai: từ khoá (BM25) + embedding ngữ nghĩa (ai_embeddings).

enum AiKnowledgeKind {
  PRODUCT
  SPEC
  CERTIFICATION
  APPLICATION
  PROJECT
  FAQ
  PROCESS
  COMPANY
  MARKET
  OTHER

  @@map("ai_knowledge_kind")
}

enum AiKnowledgeStatus {
  ACTIVE
  ARCHIVED

  @@map("ai_knowledge_status")
}

enum AiKnowledgeOrigin {
  SEED // nạp sẵn từ dữ liệu site
  HUMAN // biên tập viên nhập
  AI_WEB // AI tìm trên web, biên tập viên đã duyệt

  @@map("ai_knowledge_origin")
}

model AiKnowledge {
  id          String            @id @default(cuid())
  kind        AiKnowledgeKind
  title       String
  content     String // CHECK độ dài trong migration
  tags        String[]          @default([])
  sourceUrl   String?           @map("source_url")
  sourceTitle String?           @map("source_title")
  status      AiKnowledgeStatus @default(ACTIVE)
  origin      AiKnowledgeOrigin @default(HUMAN)
  pinned      Boolean           @default(false) // luôn đưa vào ngữ cảnh AI (vd hồ sơ công ty)
  verifiedAt  DateTime?         @map("verified_at") @db.Timestamptz(3)
  createdById String?           @map("created_by_id")
  updatedById String?           @map("updated_by_id")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User? @relation("AiKnowledgeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("AiKnowledgeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, kind])
  @@index([createdById])
  @@index([updatedById])
  @@map("ai_knowledge")
}

/// Vector embedding theo đoạn của kiến thức / bài Tin tức (cosine tính trong Node — kho nhỏ, không cần pgvector)
model AiEmbedding {
  sourceType String   @map("source_type") // 'knowledge' | 'news'
  sourceId   String   @map("source_id")
  chunk      Int
  model      String
  textHash   String   @map("text_hash")
  text       String
  vector     Float[]  @db.Real
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // model đứng đầu: mọi truy vấn đều lọc theo model trước (WHERE model = ... [AND source_type / source_id])
  @@id([model, sourceType, sourceId, chunk])
  @@map("ai_embeddings")
}

// ─── Lượt xem bài Tin tức ───────────────────────────────────────────────────
// Gộp theo ngày (giờ Việt Nam) / ngôn ngữ / nguồn truy cập — không lưu từng lượt, không lưu IP.

enum TrafficSource {
  DIRECT // không có referrer
  INTERNAL // từ trang khác của chính site
  SEARCH // Google, Bing, Cốc Cốc...
  AI // ChatGPT, Perplexity, Gemini, Copilot, Claude...
  SOCIAL // Facebook, Zalo, LinkedIn, YouTube...
  OTHER

  @@map("traffic_source")
}

model NewsPostDailyStat {
  postId      String        @map("post_id")
  locale      ContentLocale
  day         DateTime      @db.Date
  source      TrafficSource
  views       Int           @default(0)
  /// Lượt đọc tới 75% bài
  reads       Int           @default(0)
  /// Tổng số giây đọc thật (tab đang mở)
  readSeconds BigInt        @default(0) @map("read_seconds")

  post NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // PK bắt đầu bằng post_id: thống kê một bài + upsert tăng số; index day: "xem nhiều N ngày", Dashboard
  @@id([postId, locale, day, source])
  @@index([day])
  @@map("news_post_daily_stats")
}
