// This is your Prisma schema file
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  username     String?  @unique
  email        String   @unique
  password     String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deletedBanners Banner[] @relation("BannerDeletedBy")

  @@map("users")
}

enum Role {
  ADMIN
  EDITOR
}

// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  specs       ProductSpec[]

  @@map("products")
}

model ProductSpec {
  id          String  @id @default(cuid())
  productId   String
  thickness   Float
  fireRating  String? // EI value (e.g. "EI 60")
  density     Float?
  bendStrength Float?

  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_specs")
}

// ─── Banners ─────────────────────────────────────────────────────────────────

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  alt       String
  ctaText   String?
  imageUrl  String // biến thể mặc định (fallback cho <img>)
  imageKey  String // prefix object trong MinIO (vd: banners/<id>) để dọn khi xoá/thay ảnh
  images    Json // [{ width, format, url }]
  linkUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete: vào thùng rác, khôi phục được trong thời hạn lưu; job purge xoá hẳn (DB + MinIO) sau đó
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("BannerDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([deletedAt, sortOrder])
  @@map("banners")
}

// ─── Site settings (key-value) ───────────────────────────────────────────────

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
