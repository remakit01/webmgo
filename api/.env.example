PORT=4000
NODE_ENV=development

FE_URL=http://localhost:3000
CMS_URL=http://localhost:3001

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/webmgo

JWT_ACCESS_SECRET=change-me-min-32-chars
JWT_REFRESH_SECRET=change-me-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO (S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=remak-mgo-assets

# On-demand revalidation (phải trùng giá trị với fe)
REVALIDATE_SECRET_TOKEN=

# Postgres pool & timeout (tuỳ chọn, có giá trị mặc định)
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_IN_TX_TIMEOUT_MS=30000

# Dịch tự động VI -> EN trong CMS (Gemini). Bỏ trống = tắt tính năng (API trả 503)
GEMINI_API_KEY=
# Ghim phiên bản cụ thể, không dùng *-latest
GEMINI_MODEL=gemini-3.8-flash
# Model dự phòng khi model chính quá tải; để trống để tắt
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
TRANSLATE_TIMEOUT_MS=30000
# Embedding cho kho "Kiến thức AI" (AI viết bài tra cứu theo ngữ nghĩa); lỗi/hết quota -> tự tìm theo từ khoá
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Số reverse proxy (nginx, load balancer...) đứng trước API, vd 1. Để 0 khi chạy trực tiếp.
# Cần đúng để lấy IP thật của khách (chống đếm trùng lượt xem, giới hạn lượt gọi)
TRUST_PROXY=0
